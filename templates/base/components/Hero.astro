---
// Hero in three styles, picked by the variant (heroStyle):
//   photo  full-bleed photo with a dark overlay
//   split  text left, photo right
//   solid  brand-color block, no photo
// photo/split fall back to solid when the client has no hero image.
import { Image } from 'astro:assets';
import CtaButtons from './CtaButtons.astro';
import Rating from './Rating.astro';
import { clientImage } from '../images.js';
interface Props {
  site: any;
}
const { site } = Astro.props;
const { copy, business, reviews } = site;
const hero = await clientImage(site.slug, site.images.hero);
const style = hero ? site.heroStyle : 'solid';
const alt = `${business.industry} by ${business.name} in ${business.serviceArea.homeCity}, ${business.serviceArea.state}`;
const eyebrow = [copy.trustBadge, `${business.serviceArea.homeCity}, ${business.serviceArea.state}`].filter(Boolean).join(' · ');
---

{
  style === 'photo' && (
    <section id="top" class="relative isolate overflow-hidden bg-black text-white">
      <Image
        src={hero}
        alt={alt}
        width={1920}
        widths={[640, 960, 1280, 1920]}
        sizes="(max-width: 640px) 200vw, 100vw"
        priority
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/60 to-black/30 sm:bg-gradient-to-r" />
      <div class="container-x flex min-h-[36rem] flex-col justify-end py-16 sm:min-h-[40rem] sm:justify-center sm:py-24">
        <p class="text-sm font-bold tracking-[0.14em] text-white/80 uppercase">{eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl">{copy.headline}</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85 sm:text-xl">{copy.subheadline}</p>
        <CtaButtons site={site} class="mt-8" />
        {reviews.googleRating && <Rating reviews={reviews} class="mt-6 text-white/85" />}
      </div>
    </section>
  )
}
{
  style === 'split' && (
    <section id="top" class="bg-surface">
      <div class="container-x grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="mt-3 text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl">{copy.headline}</h1>
          <p class="mt-5 max-w-xl text-lg text-muted sm:text-xl">{copy.subheadline}</p>
          <CtaButtons site={site} class="mt-8" />
          {reviews.googleRating && <Rating reviews={reviews} class="mt-6 text-muted" />}
        </div>
        <Image
          src={hero}
          alt={alt}
          width={1280}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          priority
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-2xl shadow-black/20"
        />
      </div>
    </section>
  )
}
{
  style === 'solid' && (
    <section id="top" class="bg-primary text-on-primary">
      <div class="container-x py-20 text-center sm:py-28">
        <p class="text-sm font-bold tracking-[0.14em] uppercase">{eyebrow}</p>
        <h1 class="mx-auto mt-3 max-w-3xl text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl">{copy.headline}</h1>
        <p class="mx-auto mt-5 max-w-xl text-lg sm:text-xl">{copy.subheadline}</p>
        <CtaButtons site={site} class="mt-8 justify-center" />
        {reviews.googleRating && <Rating reviews={reviews} class="mt-6 justify-center" />}
      </div>
    </section>
  )
}

