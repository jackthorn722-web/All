---
// Business logo (resized) or the business name as text when there is no logo.
import { Image } from 'astro:assets';
import { clientImage, isSvg } from '../images.js';
interface Props {
  site: any;
  height?: number;
  class?: string;
}
const { site, height = 40, class: cls = '' } = Astro.props;
const file = site.images.logo;
const img = await clientImage(site.slug, file);
---

{
  !img ? (
    <span class:list={['text-lg leading-tight font-extrabold tracking-tight', cls]}>{site.business.name}</span>
  ) : isSvg(file) ? (
    <img src={img.src} alt={site.business.name} height={height} width={Math.round((img.width / img.height) * height)} class:list={['w-auto', cls]} style={`height:${height}px`} />
  ) : (
    <Image src={img} alt={site.business.name} height={height} densities={[1, 2]} class:list={['w-auto', cls]} style={`height:${height}px`} />
  )
}
