---
// Footer: name + tagline, contact, hours, socials, credit.
import Icon from './Icon.astro';
import Hours from './Hours.astro';
import Logo from './Logo.astro';
interface Props {
  site: any;
}
const { site } = Astro.props;
const { business: b } = site;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface pt-14 pb-28 md:pb-12">
  <div class="container-x grid gap-10 md:grid-cols-3">
    <div>
      <Logo site={site} />
      <p class="mt-3 text-muted">{site.copy.tagline}</p>
      <p class="mt-3 text-sm text-muted">Serving {b.cities.join(', ')}, {b.serviceArea.state}</p>
      {
        site.socials.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Find us online">
            {site.socials.map((s: any) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="inline-flex rounded-full border border-line px-3.5 py-1.5 text-sm font-semibold hover:border-current">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div>
      <h2 class="font-extrabold">Contact</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={b.telHref} class="inline-flex items-center gap-2 font-semibold hover:underline">
            <Icon name="phone" class="h-4 w-4 text-link" />{b.phoneDisplay}
          </a>
        </li>
        {
          b.textsOk && (
            <li>
              <a href={b.smsHref} class="inline-flex items-center gap-2 font-semibold hover:underline">
                <Icon name="message" class="h-4 w-4 text-link" />Text us
              </a>
            </li>
          )
        }
        <li>
          <a href={`mailto:${b.email}`} class="inline-flex items-center gap-2 font-semibold break-all hover:underline">
            <Icon name="mail" class="h-4 w-4 text-link" />{b.email}
          </a>
        </li>
        {
          b.address && (
            <li class="flex gap-2">
              <Icon name="pin" class="mt-1 h-4 w-4 shrink-0 text-link" />
              <span>
                {b.address.street}
                <br />
                {b.address.city}, {b.address.state} {b.address.zip}
              </span>
            </li>
          )
        }
      </ul>
    </div>
    <div>
      <h2 class="font-extrabold">Hours</h2>
      <Hours site={site} class="mt-4 max-w-xs" />
    </div>
  </div>
  <div class="container-x mt-12 flex flex-wrap justify-between gap-2 border-t border-line pt-6 text-sm text-muted">
    <p>© {year} {b.name}</p>
    <p>Website by <a href="https://dialedinsites.com" class="underline-offset-4 hover:underline">DialedIn Sites</a></p>
  </div>
</footer>
