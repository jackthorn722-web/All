---
// Reviews: rating summary + link to Google, then review cards.
import Section from './Section.astro';
import Icon from './Icon.astro';
import Rating from './Rating.astro';
interface Props {
  site: any;
}
const { site } = Astro.props;
const { reviews } = site;
---

<Section id="reviews" eyebrow="Reviews" title={site.copy.reviewsTitle} intro={site.copy.reviewsIntro}>
  {
    (reviews.googleRating || reviews.googleReviewsUrl) && (
      <div class="-mt-4 mb-8 flex flex-wrap items-center gap-x-6 gap-y-2">
        <Rating reviews={{ ...reviews, googleReviewsUrl: undefined }} class="text-base" />
        {reviews.googleReviewsUrl && (
          <a href={reviews.googleReviewsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-bold text-link hover:underline">
            See all reviews on Google <Icon name="external" class="h-4 w-4" />
          </a>
        )}
      </div>
    )
  }
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      reviews.items.map((r: any) => (
        <figure class="flex flex-col rounded-3xl border border-line bg-surface p-6 sm:p-7">
          <div class="flex text-[#fbbc04]" role="img" aria-label={`${r.rating} out of 5 stars`}>
            {[1, 2, 3, 4, 5].map((n) => (
              <Icon name="star" filled={n <= r.rating} class="h-5 w-5" />
            ))}
          </div>
          <blockquote class="mt-4 flex-1 text-lg leading-relaxed">“{r.text}”</blockquote>
          <figcaption class="mt-5 text-sm">
            <span class="font-bold">{r.name}</span>
            <span class="text-muted"> · via {r.source}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
