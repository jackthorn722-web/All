---
// FAQ with native <details> (no JavaScript).
import Section from './Section.astro';
import Icon from './Icon.astro';
interface Props {
  site: any;
}
const { site } = Astro.props;
---

<Section id="faq" eyebrow="FAQ" title={site.copy.faqTitle} tone="surface">
  <div class="max-w-3xl divide-y divide-line rounded-3xl border border-line bg-bg">
    {
      site.faq.map((f: any) => (
        <details class="group p-5 sm:p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon name="chevron" class="h-5 w-5 shrink-0 text-link transition group-open:rotate-180" />
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
        </details>
      ))
    }
  </div>
</Section>
