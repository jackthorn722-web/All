---
// Grouped opening hours, e.g. "Mon–Fri 8am–6pm", plus the optional note.
interface Props {
  site: any;
  class?: string;
}
const { site, class: cls = '' } = Astro.props;
---

<div class={cls}>
  <dl class="space-y-2">
    {
      site.hours.map((h: any) => (
        <div class="flex justify-between gap-6">
          <dt class="font-semibold">{h.label}</dt>
          <dd class:list={[h.closed && 'text-muted']}>{h.value}</dd>
        </div>
      ))
    }
  </dl>
  {site.business.hoursNote && <p class="mt-3 text-sm text-muted">{site.business.hoursNote}</p>}
</div>
