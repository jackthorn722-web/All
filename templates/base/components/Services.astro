---
// Services grid: name, "From $X", description, bullet features, quote link.
import Section from './Section.astro';
import Icon from './Icon.astro';
interface Props {
  site: any;
}
const { site } = Astro.props;
const n = site.services.length;
// Full class names so Tailwind can see them.
const cols = n === 1 ? 'max-w-xl' : n === 2 || n === 4 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
const money = (v: number) => `$${Number.isInteger(v) ? v : v.toFixed(2)}`;
---

<Section id="services" eyebrow={site.business.industry} title={site.copy.servicesTitle} intro={site.copy.servicesIntro}>
  <div class:list={['grid gap-5', cols]}>
    {
      site.services.map((s: any) => (
        <article class="flex flex-col rounded-3xl border border-line bg-surface p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">{s.name}</h3>
            {s.startingPrice && (
              <p class="text-lg font-bold text-link">
                <span class="text-sm font-semibold text-muted">From </span>
                {money(s.startingPrice)}
              </p>
            )}
          </div>
          <p class="mt-3 text-muted">{s.description}</p>
          {s.features.length > 0 && (
            <ul class="mt-5 space-y-2.5">
              {s.features.map((f: string) => (
                <li class="flex gap-3">
                  <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-link" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          )}
          <a href="#contact" data-service={s.name} class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-link hover:underline">
            Get a quote <Icon name="arrow" class="h-4 w-4" />
          </a>
        </article>
      ))
    }
  </div>
</Section>
