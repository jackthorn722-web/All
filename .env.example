# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# --- Contact form (Web3Forms, https://web3forms.com) ---
# One access key sends to ONE inbox. WEB3FORMS_KEY is the default for every site.
WEB3FORMS_KEY=
# To send a client's leads to their own inbox, add a key just for them:
#   WEB3FORMS_KEY_<SLUG in caps, dashes as underscores>=...
# WEB3FORMS_KEY_TWINTUNED=

# --- Cloudflare Pages (npm run deploy) ---
# Account ID: dashboard > Workers & Pages, shown on the right.
CLOUDFLARE_ACCOUNT_ID=
# API token: My Profile > API Tokens > Create Custom Token with
#   Account | Cloudflare Pages | Edit,  Zone | DNS | Edit,  Zone | Zone | Read
#   (zone resources: all zones from your account). Without a token, deploy signs in
#   through the browser and prints the domain steps instead of doing them.
CLOUDFLARE_API_TOKEN=
