# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# --- Contact form (Web3Forms, https://web3forms.com) ---
# One access key sends to ONE inbox. WEB3FORMS_KEY is the default for every site.
WEB3FORMS_KEY=
# To send a client's leads to their own inbox, add a key just for them:
#   WEB3FORMS_KEY_<SLUG in caps, dashes as underscores>=...
# WEB3FORMS_KEY_TWINTUNED=

# --- Cloudflare Pages (Phase 2: npm run deploy) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
